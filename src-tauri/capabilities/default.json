{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Saavi main window: save-backup dialog + file write, WKD key fetch.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-save",
    "fs:allow-write-text-file",
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "$HOME/**" }, { "path": "$DOWNLOAD/**" }, { "path": "$DOCUMENT/**" }]
    },
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://**" }]
    }
  ]
}
