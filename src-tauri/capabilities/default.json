{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Saavi main window: save-backup dialog (the chosen path is scoped by the dialog itself) + file write, WKD key fetch over HTTPS.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-save",
    "fs:allow-write-text-file",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://**"
        }
      ]
    }
  ]
}
